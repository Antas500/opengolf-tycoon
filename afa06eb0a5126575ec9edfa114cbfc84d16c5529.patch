+		for y in range(60,70):
+			var p := Vector2i(x,y)
+			if not _is_owned(p): continue
+			if grid.get_tile(p) in [TerrainTypes.Type.GREEN,TerrainTypes.Type.TEE_BOX,TerrainTypes.Type.FAIRWAY]: continue
