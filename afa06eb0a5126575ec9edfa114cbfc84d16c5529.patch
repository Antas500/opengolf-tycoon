+	assert(gm.daily_stats.golfers_arrived == 7)
+	print("BUILDER_REGRESSION_PASS: starter surfaces, obstacle restore, exact cash undo/redo, unaffordable redo, cancel stroke, save accounting")
+	quit(0)
